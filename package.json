{
  "name": "syncode",
  "displayName": "SynCode",
  "description": "Real-time pair editing over the local network (Yjs CRDT, no cloud).",
  "version": "0.0.1",
  "publisher": "syncode",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://example.invalid/syncode.git"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:syncode",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "syncode.startHosting",
        "title": "Start Hosting",
        "category": "SynCode"
      },
      {
        "command": "syncode.stopSession",
        "title": "Stop Session",
        "category": "SynCode"
      },
      {
        "command": "syncode.joinSession",
        "title": "Join Session…",
        "category": "SynCode"
      },
      {
        "command": "syncode.reconnectMirror",
        "title": "Reconnect Mirror",
        "category": "SynCode"
      },
      {
        "command": "syncode.copyJoinInfo",
        "title": "Copy Join Info",
        "category": "SynCode"
      },
      {
        "command": "syncode.followParticipant",
        "title": "Follow Participant",
        "category": "SynCode"
      },
      {
        "command": "syncode.setIdentity",
        "title": "Set Name and Color",
        "category": "SynCode"
      },
      {
        "command": "syncode.openRemoteFile",
        "title": "Open Remote File…",
        "category": "SynCode"
      },
      {
        "command": "syncode.showMenu",
        "title": "Show Menu",
        "category": "SynCode"
      },
      {
        "command": "syncode.hello",
        "title": "Hello",
        "category": "SynCode"
      },
      {
        "command": "syncode.debugMirror",
        "title": "Debug: Mirror Active Editor (toggle)",
        "category": "SynCode"
      },
      {
        "command": "syncode.undo",
        "title": "Undo My Last Edit",
        "category": "SynCode"
      },
      {
        "command": "syncode.redo",
        "title": "Redo My Last Edit",
        "category": "SynCode"
      }
    ],
    "configuration": {
      "title": "SynCode",
      "properties": {
        "syncode.displayName": {
          "type": "string",
          "default": "",
          "description": "Name shown to other participants. Defaults to your user name."
        },
        "syncode.color": {
          "type": "string",
          "default": "",
          "description": "Cursor color shown to others (CSS color). Defaults to a color derived from your name."
        },
        "syncode.port": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "Port the host listens on. 0 picks a free port each time; fix it to keep one firewall rule."
        },
        "syncode.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**"
          ],
          "description": "Glob patterns of files that are not shared (in addition to .gitignore)."
        },
        "syncode.respectGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Hide files ignored by .gitignore from guests (as well as syncode.exclude)."
        },
        "syncode.maxFileSizeKB": {
          "type": "integer",
          "default": 2048,
          "minimum": 1,
          "description": "Largest text file that is synced, in KB."
        },
        "syncode.nameLabels": {
          "type": "string",
          "enum": [
            "always",
            "whileMoving",
            "never"
          ],
          "enumDescriptions": [
            "Always show the name above each remote cursor.",
            "Show the name for a few seconds after the cursor moves.",
            "Never show names (hover a cursor to see it)."
          ],
          "default": "always",
          "description": "When to show participants' names above their cursors."
        },
        "syncode.advertise": {
          "type": "boolean",
          "default": true,
          "description": "Announce hosted sessions on the local network (mDNS) so guests can pick them in Join Session."
        },
        "syncode.localUndo": {
          "type": "boolean",
          "default": true,
          "description": "In shared files, Ctrl+Z / Ctrl+Shift+Z undo and redo only your own edits (the editor's native undo would also revert other participants' edits)."
        }
      }
    },
    "keybindings": [
      {
        "command": "syncode.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "editorTextFocus && syncode.sharedEditor && !editorReadonly"
      },
      {
        "command": "syncode.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "editorTextFocus && syncode.sharedEditor && !editorReadonly"
      },
      {
        "command": "syncode.redo",
        "key": "ctrl+y",
        "when": "editorTextFocus && syncode.sharedEditor && !editorReadonly"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run typecheck && node esbuild.mjs --production && vsce package --no-dependencies --out syncode.vsix",
    "test:integration": "npm run build && node test/integration/runTest.mjs",
    "test:pair": "npm run build && node test/integration/runPair.mjs",
    "test:mirror": "npm run build && node test/integration/runPair.mjs mirror"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "lib0": "0.2.119",
    "ws": "8.22.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.107.0",
    "@types/ws": "8.18.2",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
